{"nodes": [{"id": "_claude_skills_graphify_references_query_reference_doc", "label": "Query Reference", "file_type": "document", "source_file": ".claude/skills/graphify/references/query.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "_claude_skills_graphify_references_query_vocab_expansion", "label": "Constrained Query Vocabulary Expansion", "file_type": "concept", "source_file": ".claude/skills/graphify/references/query.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The query matcher does case-folded substring + IDF only - no stemming, no synonyms, no cross-language matching - so a question phrased in different vocabulary than the graph's node labels would silently return zero hits; expansion is constrained to only tokens already present in the graph's vocabulary to avoid inventing false matches."}, {"id": "_claude_skills_graphify_references_query_work_memory_lessons", "label": "Work Memory / LESSONS.md Self-Improving Loop", "file_type": "concept", "source_file": ".claude/skills/graphify/references/query.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Saving Q&A results with an outcome (useful/dead_end/corrected) closes a feedback loop: the next --update extracts the saved answer as a graph node, and preferred sources / dead ends / corrections surface via LESSONS.md so future sessions don't re-derive the same dead ends."}], "edges": [{"source": "_claude_skills_graphify_references_query_reference_doc", "target": "_claude_skills_graphify_references_query_vocab_expansion", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/graphify/references/query.md", "source_location": null, "weight": 1.0}, {"source": "_claude_skills_graphify_references_query_reference_doc", "target": "_claude_skills_graphify_references_query_work_memory_lessons", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/graphify/references/query.md", "source_location": null, "weight": 1.0}, {"source": "_claude_skills_graphify_references_query_reference_doc", "target": "_claude_skills_graphify_skill_graph_json_artifact", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/graphify/references/query.md", "source_location": null, "weight": 1.0}], "hyperedges": []}